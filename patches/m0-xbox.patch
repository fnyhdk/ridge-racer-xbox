+/* span_fix with depth and semi-transparency made constants. */
+static unsigned long span_fix_any(u16 *p, u16 *end, u32 U, u32 V, u32 dU, u32 dV,
+                                  const u16 *tex, const u16 *clut, int depth,
+                                  int semi, int mode, u16 mset)
