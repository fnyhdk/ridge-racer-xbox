+/* floor(n / d) in the top byte, and the rest in 24 bits of fraction rounded
+ * down -- span_fix's form -- for an n of either sign. */
+static u32 fix_value(long long n, const struct rdiv *d)
+{
+    long long q, r;
+    /* A 64-bit division is a library call on the Pentium III; n nearly
+       always fits in 32 bits, and d < 2^23 always does. */
+    if (n == (long long)(int)n) { q = (int)n / (int)d->d; r = (int)n % (int)d->d; }
+    else { q = n / (long long)d->d; r = n % (long long)d->d; }
+    if (r < 0) { r += d->d; q--; }
+    return ((u32)q << 24) + frac24((u32)r, d);
+}
