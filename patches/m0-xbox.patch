 struct vtx { int x, y; int r, g, b; int u, v; };
 
+/* The same triangle, without a division per pixel.
+ *
+ * The reference loop below tests the three edge functions at every pixel of
+ * the bounding box and divides up to five times per pixel to interpolate.
+ * That is the clearest statement of what is drawn, and on a desktop it costs
+ * nothing worth mentioning; on the Xbox's Pentium III, where a division takes
+ * forty cycles, the divisions alone would eat a third of the frame.
+ *
+ * What changes here is only how the same numbers are reached:
+ *
+ *  - each edge function is linear in x along a row, so the pixels where all
+ *    three are non-negative form one span, found by solving three
+ *    inequalities instead of testing every pixel;
+ *
+ *  - each interpolated value is N(x) / area, with N linear in x. Its quotient
+ *    and remainder are carried from one pixel to the next by an addition and
+ *    a carry. Inside the triangle N is never negative, so the floor this
+ *    computes is the truncation C's division gives: the result is the same
+ *    to the last bit.
+ *
+ * Everything stays in 32 bits as long as twice the area is below 2^23 -- a
+ * triangle larger than video memory itself. The rare one beyond that goes
+ * through the reference loop, which is kept as it was. */
+struct step { int q, r, dq, dr; };
+
+/* Division by a number fixed for the whole triangle, without a divide.
+ *
+ * The divisions left at the start of each row are all by the same few
+ * numbers -- the area, the edges' slopes -- and on the Pentium III each costs
+ * forty cycles; a race frame has nineteen thousand rows. m is the reciprocal
+ * rounded down, floor((2^32 - 1) / d), at most one below 2^32 / d. For
+ * 0 <= n < 2^31 the estimate n * m / 2^32 then falls short of n / d by less
+ * than a half: it is the quotient or one less, and one comparison settles
+ * which. The result is C's division, exactly. */
+struct rdiv { u32 d, m; };
+
+static INLINE void rdiv_init(struct rdiv *r, u32 d)
+{
+    r->d = d;
+    r->m = 0xFFFFFFFFu / d;
+}
+
+static INLINE u32 rdiv_q(const struct rdiv *r, u32 n)
+{
+    u32 q = (u32)(((unsigned long long)n * r->m) >> 32);
+    if (n - q * r->d >= r->d) q++;
+    return q;
+}
+
+/* How a value moves as x grows by one: the same for every row. */
+static INLINE void step_slope(struct step *s, int dn, int area)
+{
+    s->dq = dn / area;
+    s->dr = dn % area;
+    if (s->dr < 0) { s->dr += area; s->dq--; }
+}
+
+/* Where it starts on a row: n0 is never negative inside the triangle. */
+static INLINE void step_start(struct step *s, int n0, const struct rdiv *area)
+{
+    s->q = (int)rdiv_q(area, (u32)n0);
+    s->r = n0 - s->q * (int)area->d;
+}
+
+static INLINE void step_next(struct step *s, int area)
+{
+    s->q += s->dq;
+    s->r += s->dr;
+    if (s->r >= area) { s->r -= area; s->q++; }
+}
