+/* The same span in fixed point, when that is provably the same.
+ *
+ * span_tex steps u as a quotient and a remainder, exactly: u = n / area, two
+ * adds and a compare per coordinate, and its state spills off the Pentium
+ * III's seven registers. Here u is one 32-bit number: the low eight bits of
+ * the quotient on top, 24 bits of fraction below. Adding the step wraps the
+ * top byte by itself, which is the & 255 the texture page applies, and
+ * u >> 24 is the texel column. The same for v.
+ *
+ * Why the same texel. Write the true u in units of 2^-24: T(k) = n(k) * 2^24
+ * / area at pixel k. The start fraction and the step's fraction are rounded
+ * down, so after k steps the sum has lost less than k + 1 units; it starts
+ * with `len` units added, so for every k < len it is at or above T(k). The
+ * true fraction is a whole number of 1/area, so the next whole u lies at
+ * least 2^24 / area units above T(k); with len * area < 2^24 the sum, at most
+ * T(k) + len, stays below it. Its top byte is therefore floor(T) & 255, the
+ * value span_tex reads. Spans longer than that, which only very large
+ * triangles have, go through span_tex.
+ *
+ * The other conditions are the triangle's: no texture window (the masks are
+ * then all ones and zero), and a page and CLUT that do not run off the edge
+ * of video memory, so that the wrap vram_get applies never happens and a
+ * pointer can stand in for it. */
+static INLINE u32 frac24(u32 r, const struct rdiv *a)
+{
+    /* floor(r * 2^24 / d) for r < d < 2^23, by long division in base 256. */
+    u32 x = r << 8, q1, q2, q3;
+    q1 = rdiv_q(a, x); x = (x - q1 * a->d) << 8;
+    q2 = rdiv_q(a, x); x = (x - q2 * a->d) << 8;
+    q3 = rdiv_q(a, x);
+    return (q1 << 16) | (q2 << 8) | q3;
+}
