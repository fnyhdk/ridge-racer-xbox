+/* The span of a textured, untinted triangle with no mask test: nine pixels in
+ * ten of a race. The general loop below asks at every pixel whether to tint,
+ * which texture depth, whether to test the mask; with the Pentium III's seven
+ * registers its state lives on the stack, and those questions cost more than
+ * the pixel. Here they are settled once per span -- depth is a constant at
+ * each call -- and what is drawn is the same, in the same order. Returns the
+ * number of transparent texels. */
+static ALWAYS_INLINE unsigned long span_tex(u16 *row, int lo, int hi,
+                                            struct step su, struct step sv, int ar,
+                                            const struct texctx *t, int depth,
+                                            int semi, int mode, int mset)
+{
+    unsigned long empty = 0;
+    u16 *p = row + lo, *end = row + hi + 1;
+    int uq = su.q, ur = su.r, vq = sv.q, vr = sv.r;
+    for (; p < end; p++) {
+        int u = ((uq & t->um) | t->uo) & 255, v = ((vq & t->vm) | t->vo) & 255;
+        u16 col;
+        if (depth == 0) {
+            u16 w = vram_get(t->bx + (u >> 2), t->by + v);
+            col = vram_get(t->cx + ((w >> ((u & 3) * 4)) & 0xF), t->cy);
+        } else if (depth == 1) {
+            u16 w = vram_get(t->bx + (u >> 1), t->by + v);
+            col = vram_get(t->cx + ((w >> ((u & 1) * 8)) & 0xFF), t->cy);
+        } else {
+            col = vram_get(t->bx + u, t->by + v);
+        }
+        if (col == 0) empty++;
+        else {
+            if (semi && (col & 0x8000)) col = blend(*p, col, mode);
+            *p = (u16)(col | mset);
+        }
+        uq += su.dq; ur += su.dr; if (ur >= ar) { ur -= ar; uq++; }
+        vq += sv.dq; vr += sv.dr; if (vr >= ar) { vr -= ar; vq++; }
+    }
+    return empty;
+}
