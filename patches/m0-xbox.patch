+static ALWAYS_INLINE unsigned long span_fix(u16 *p, u16 *end, u32 U, u32 V,
+                                            u32 dU, u32 dV, const u16 *tex,
+                                            const u16 *clut, int depth,
+                                            int semi, int mode, u16 mset)
+{
+    unsigned long empty = 0;
+    for (; p < end; p++) {
+        u32 u = U >> 24, v = V >> 24;
+        u16 col;
+        if (depth == 0)
+            col = clut[(tex[(v << 10) + (u >> 2)] >> ((u & 3) << 2)) & 0xF];
+        else if (depth == 1)
+            col = clut[(tex[(v << 10) + (u >> 1)] >> ((u & 1) << 3)) & 0xFF];
+        else
+            col = tex[(v << 10) + u];
+        U += dU; V += dV;
+        if (col == 0) { empty++; continue; }
+        if (semi && (col & 0x8000)) col = blend(*p, col, mode);
+        *p = (u16)(col | mset);
+    }
+    return empty;
+}
