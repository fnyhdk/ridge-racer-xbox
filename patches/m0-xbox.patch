+/* tex_lookup's state, read once per triangle rather than once per pixel.
+ * Under -fno-strict-aliasing every store into video memory may alias the
+ * globals, so the compiler cannot hoist them itself. */
+struct texctx { int bx, by, depth, cx, cy, um, uo, vm, vo; };
+
+static void texctx_init(struct texctx *t, u32 tp, u32 clut)
+{
+    t->bx = (int)(tp & 0xF) * 64;
+    t->by = (int)((tp >> 4) & 1) * 256;
+    t->depth = (int)((tp >> 7) & 3);
+    t->cx = (int)(clut & 0x3F) * 16;
+    t->cy = (int)((clut >> 6) & 0x1FF);
+    t->um = ~(tw_mx * 8); t->uo = (tw_ox & tw_mx) * 8;
+    t->vm = ~(tw_my * 8); t->vo = (tw_oy & tw_my) * 8;
+}
+
+/* The same texel as tex_lookup, zero when transparent. */
+static INLINE u16 texel(const struct texctx *t, int u, int v)
+{
+    u = ((u & t->um) | t->uo) & 255;
+    v = ((v & t->vm) | t->vo) & 255;
+    if (t->depth == 0) {
+        u16 w = vram_get(t->bx + (u >> 2), t->by + v);
+        return vram_get(t->cx + ((w >> ((u & 3) * 4)) & 0xF), t->cy);
+    }
+    if (t->depth == 1) {
+        u16 w = vram_get(t->bx + (u >> 1), t->by + v);
+        return vram_get(t->cx + ((w >> ((u & 1) * 8)) & 0xFF), t->cy);
+    }
+    return vram_get(t->bx + u, t->by + v);
+}
+
+/* Narrows [*lo, *hi] to the t >= 0 where w - t * d >= 0. rd divides by |d|. */
+static INLINE void edge_span(int w, int d, const struct rdiv *rd, int *lo, int *hi)
+{
+    if (d > 0) {
+        int t;
+        if (w < 0) { *hi = -1; return; }
+        t = (int)rdiv_q(rd, (u32)w);
+        if (t < *hi) *hi = t;
+    } else if (d < 0) {
+        if (w < 0) { int m = (int)rdiv_q(rd, (u32)(-w + -d - 1)); if (m > *lo) *lo = m; }
+    } else if (w < 0) {
+        *hi = -1;
+    }
+}
