+    case 1:  return span_fix(p, end, U, V, dU, dV, tex, clut, 0, 1, mode, mset);
+    case 2:  return span_fix(p, end, U, V, dU, dV, tex, clut, 1, 0, mode, mset);
+    case 3:  return span_fix(p, end, U, V, dU, dV, tex, clut, 1, 1, mode, mset);
+    case 4: case 6:
